<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/fundo_cartao_gesto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <TextView
        android:id="@+id/gesto_emoji"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/fundo_icone_circulo"
        android:gravity="center"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gesto_etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_chip_verde"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/gs_verde"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gesto_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/gs_texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gesto_descricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gs_texto_suave"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
