<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_painel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/fundo_pega_painel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Definições"
            android:textColor="@color/gs_texto"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ds_subtitulo_modo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/gs_primario"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ds_titulo_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/gs_texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ds_ajuda_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gs_texto_suave"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/ds_campo_ip_pc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/fundo_campo_ip"
            android:digits="0123456789."
            android:hint="ex: 192.168.1.42"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:maxLength="15"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:singleLine="true"
            android:textColor="@color/gs_texto"
            android:textColorHint="#77779A"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/ds_campo_ip_esp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/fundo_campo_ip"
            android:digits="0123456789."
            android:hint="ex: 192.168.1.50"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:maxLength="15"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:singleLine="true"
            android:textColor="@color/gs_texto"
            android:textColorHint="#77779A"
            android:textSize="20sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ds_switch_vibracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Vibração ao reconhecer gesto"
            android:textColor="@color/gs_texto"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ds_switch_som"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Som ao reconhecer gesto"
            android:textColor="@color/gs_texto"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Confirmação (manter o gesto 2 segundos)"
            android:textColor="@color/gs_texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/ds_grupo_confirmacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/ds_confirm_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desligada"
                android:textColor="@color/gs_texto"
                android:textSize="15sp" />


            <RadioButton
                android:id="@+id/ds_confirm_todos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ligada"
                android:textColor="@color/gs_texto"
                android:textSize="15sp" />
        </RadioGroup>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ds_botao_guardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/fundo_botao_principal"
            android:stateListAnimator="@null"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ds_botao_conta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Conta"
            android:textColor="@color/gs_primario"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ds_botao_historico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Ver histórico"
            android:textColor="@color/gs_primario"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ds_botao_mudar_modo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Mudar de modo"
            android:textColor="@color/gs_primario"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>